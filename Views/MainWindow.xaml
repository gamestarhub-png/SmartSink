<Window
    x:Class="SmartSink.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:SmartSink.ViewModels"
    Title="SmartSink">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="/AppIcon.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="SmartSink" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1"
                        x:Name="TopNavigation"
                        PaneDisplayMode="LeftCompact"
                        IsPaneToggleButtonVisible="True"
                        IsPaneOpen="True"
                        OpenPaneLength="220"
                        CompactPaneLength="48"
                        Background="{StaticResource SmartSinkPageBrush}"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="TopNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ReceiverNavigationItem" Content="Receiver" Tag="receiver">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Information" Tag="information">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <ScrollViewer x:Name="ReceiverPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,36" Spacing="22" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Phone audio receiver" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Play audio from a paired phone through the current Windows output." TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>

                        <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.ApplicationStateText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EA;" FontSize="15" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPhoneName, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.72" />
                                    </StackPanel>
                                    <TextBlock Text="Audio follows the Windows default output, including connected headphones." TextWrapping="Wrap" Opacity="0.62" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="AcceptPhoneAudioToggle"
                                              Header="Accept phone audio"
                                              OffContent="Off"
                                              OnContent="On"
                                              IsOn="{x:Bind ViewModel.AcceptPhoneAudio, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.ReceiverControlsEnabled, Mode=OneWay}"
                                              Toggled="AcceptPhoneAudio_Toggled"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Visibility="{x:Bind ViewModel.QuickSetupVisibility, Mode=OneWay}"
                                Padding="24"
                                CornerRadius="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="76" Height="76" CornerRadius="38" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <Image Source="/TrayIcon.png" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBlock Text="Quick setup" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="1. Pair your phone in Windows Bluetooth settings.&#x0a;2. Keep Bluetooth enabled on both devices.&#x0a;3. Return here, select the phone, and turn on Accept phone audio." TextWrapping="Wrap" LineHeight="24" />
                                    <Button Click="OpenBluetoothSettings_Click" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE702;" />
                                            <TextBlock Text="Open Bluetooth settings" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Pairing is handled entirely by Windows. SmartSink does not replace or reconfigure Phone Link." TextWrapping="Wrap" Opacity="0.62" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{x:Bind ViewModel.DeviceSectionVisibility, Mode=OneWay}" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Your phones" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Choose a compatible paired device" Opacity="0.62" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OpenBluetoothSettings_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE702;" />
                                        <TextBlock Text="Bluetooth settings" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListView x:Name="DevicesList"
                                      ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Width" Value="300" />
                                        <Setter Property="MinHeight" Value="140" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:BluetoothDeviceViewModel">
                                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid RowSpacing="14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                                        <Image Source="/TrayIcon.png" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" Opacity="0.68" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Route"
                                                            ToolTipService.ToolTip="Route this phone's audio to the current Windows output"
                                                            IsEnabled="{x:Bind CanRoute, Mode=OneWay}"
                                                            Tag="{x:Bind Id}"
                                                            Click="RouteDevice_Click" />
                                                    <Button Content="Stop"
                                                            ToolTipService.ToolTip="Stop receiving this phone's audio and release SmartSink's A2DP connection"
                                                            IsEnabled="{x:Bind CanStop, Mode=OneWay}"
                                                            Tag="{x:Bind Id}"
                                                            Click="DisableDevice_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <Border Padding="16" CornerRadius="12" Background="{StaticResource SmartSinkSubtlePanelBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" Foreground="{StaticResource SmartSinkCyanBrush}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="About Accept phone audio" FontWeight="SemiBold" />
                                    <TextBlock Text="Turning it off disposes SmartSink's A2DP connection. Your phone stays paired, Bluetooth stays enabled, and Phone Link remains available." TextWrapping="Wrap" Opacity="0.72" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <InfoBar IsOpen="{x:Bind ViewModel.IsAvailabilityWarningOpen, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Warning"
                                 Title="Bluetooth sink availability"
                                 Message="{x:Bind ViewModel.AvailabilityText, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,36" Spacing="22" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Choose how SmartSink starts and behaves in the notification area." TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>

                        <Border Padding="22" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="18">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Permissions &amp; privacy" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="SmartSink asks Windows only for access needed to receive phone audio." TextWrapping="Wrap" Opacity="0.66" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            ToolTipService.ToolTip="Refresh permission status"
                                            IsEnabled="{x:Bind ViewModel.CanRefreshPermissions, Mode=OneWay}"
                                            Click="RefreshPermissions_Click">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" />
                                    </Button>
                                </Grid>

                                <Border Padding="16" CornerRadius="12" Background="{StaticResource SmartSinkSubtlePanelBrush}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource SmartSinkAccentPanelBrush}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE702;" Foreground="{StaticResource SmartSinkCyanBrush}" FontSize="18" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Bluetooth devices" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.BluetoothPermissionStatus, Mode=OneWay}" Foreground="{StaticResource SmartSinkCyanBrush}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.BluetoothPermissionDetail, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.66" />
                                            <TextBlock Text="{x:Bind ViewModel.BluetoothPermissionTechnicalStatus, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Opacity="0.48" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Bluetooth settings"
                                                Click="OpenBluetoothSettings_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Padding="16" CornerRadius="12" Background="{StaticResource SmartSinkSubtlePanelBrush}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource SmartSinkAccentPanelBrush}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" Foreground="{StaticResource SmartSinkCyanBrush}" FontSize="18" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Desktop integration" FontWeight="SemiBold" />
                                            <TextBlock Text="Required for the WinUI desktop window, notification-area icon, and native tray menu. SmartSink uses your normal user permissions and never requests administrator access." TextWrapping="Wrap" Opacity="0.66" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Padding="16" CornerRadius="12" Background="{StaticResource SmartSinkSubtlePanelBrush}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource SmartSinkAccentPanelBrush}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" Foreground="{StaticResource SmartSinkCyanBrush}" FontSize="18" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Local data only" FontWeight="SemiBold" />
                                            <TextBlock Text="Settings and logs stay in this app's per-user local storage. There is no telemetry, analytics, advertising, account, or cloud upload. Copied diagnostics omit Bluetooth addresses and device IDs." TextWrapping="Wrap" Opacity="0.66" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Padding="14" CornerRadius="10" Background="{StaticResource SmartSinkSubtlePanelBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" Foreground="{StaticResource SmartSinkCyanBrush}" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Not requested" FontWeight="SemiBold" />
                                            <TextBlock Text="SmartSink does not request microphone, camera, location, contacts, broad file access, radio control, or Internet-client capabilities." TextWrapping="Wrap" Opacity="0.68" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Review app in Windows" Click="OpenAppPermissionSettings_Click" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PermissionNotice, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.66" />
                            </StackPanel>
                        </Border>

                        <Border Padding="22" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="18">
                                <TextBlock Text="Startup behavior" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch Header="Start minimized to the notification area" IsOn="{x:Bind ViewModel.Settings.StartMinimized, Mode=TwoWay}" Toggled="Setting_Toggled" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.StartupMessage, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.62" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Manage in Windows" Click="OpenStartupAppsSettings_Click" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="22" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="18">
                                <TextBlock Text="Receiver behavior" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch Header="Close window to the notification area" IsOn="{x:Bind ViewModel.Settings.CloseToTray, Mode=TwoWay}" Toggled="Setting_Toggled" />
                                <ToggleSwitch Header="Automatically enable the receiver for the last phone" IsOn="{x:Bind ViewModel.Settings.AutoEnableReceiver, Mode=TwoWay}" Toggled="Setting_Toggled" />
                                <ToggleSwitch Header="Automatically attempt to reconnect the last phone" IsOn="{x:Bind ViewModel.Settings.AutoReconnect, Mode=TwoWay}" Toggled="Setting_Toggled" />
                            </StackPanel>
                        </Border>

                        <Border Padding="22" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Windows Bluetooth" FontWeight="SemiBold" />
                                    <TextBlock Text="Pair, rename, or remove phones using Windows settings." TextWrapping="Wrap" Opacity="0.62" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open settings" Click="OpenBluetoothSettings_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="InformationPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,36" Spacing="22" HorizontalAlignment="Stretch">
                        <StackPanel.Resources>
                            <Style x:Key="DiagnosticLabelStyle" TargetType="TextBlock">
                                <Setter Property="Opacity" Value="0.64" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                            <Style x:Key="DiagnosticValueStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </StackPanel.Resources>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Information" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="See the information SmartSink currently needs and uses." TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>

                        <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="20" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/AppIcon.png" Width="68" Height="68" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="SmartSink" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Bluetooth A2DP audio receiver for Windows" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" FontSize="12" Opacity="0.62" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="AuthorWebsite_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                                            <TextBlock Text="Author Website" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="GitHub_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;" />
                                            <TextBlock Text="GitHub" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Available information" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="A simple view of the receiver and selected phone" Opacity="0.62" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Refresh"
                                            IsEnabled="{x:Bind ViewModel.CanRefreshDiagnostics, Mode=OneWay}"
                                            Click="RefreshDiagnostics_Click"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnSpacing="18" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Selected phone" Style="{StaticResource DiagnosticLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDiagnosticPhone, Mode=OneWay}" Style="{StaticResource DiagnosticValueStyle}" />
                                    <TextBlock Grid.Row="1" Text="Receiver state" Style="{StaticResource DiagnosticLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ReceiverConnectionState, Mode=OneWay}" Style="{StaticResource DiagnosticValueStyle}" />
                                    <TextBlock Grid.Row="2" Text="Audio destination" Style="{StaticResource DiagnosticLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AudioRouteDescription, Mode=OneWay}" Style="{StaticResource DiagnosticValueStyle}" />
                                </Grid>
                                <InfoBar IsOpen="{x:Bind ViewModel.IsConnectionErrorOpen, Mode=OneWay}"
                                         IsClosable="False"
                                         Severity="Error"
                                         Title="Connection problem"
                                         Message="{x:Bind ViewModel.ConnectionErrorDetail, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Bluetooth" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Basic information currently available from Windows" Opacity="0.62" />
                                </StackPanel>

                                <InfoBar IsOpen="{x:Bind ViewModel.IsBluetoothStatusWarningOpen, Mode=OneWay}"
                                         IsClosable="False"
                                         Severity="Warning"
                                         Title="{x:Bind ViewModel.DiagnosticsStatus, Mode=OneWay}"
                                         Message="Open Windows Bluetooth settings to check the adapter and radio." />

                                <Grid ColumnSpacing="18" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Adapter" Style="{StaticResource DiagnosticLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AdapterName, Mode=OneWay}" Style="{StaticResource DiagnosticValueStyle}" />
                                    <TextBlock Grid.Row="1" Text="Support" Style="{StaticResource DiagnosticLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AdapterSupport, Mode=OneWay}" Style="{StaticResource DiagnosticValueStyle}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.LastDiagnosticsRefresh, Mode=OneWay}" FontSize="12" Opacity="0.56" />
                            </StackPanel>
                        </Border>

                        <Border Padding="16" CornerRadius="12" Background="{StaticResource SmartSinkSubtlePanelBrush}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Shareable status" FontWeight="SemiBold" />
                                    <TextBlock Text="Copies the status shown above. Private device identifiers and system or driver details are left out." TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsNotice, Mode=OneWay}" Opacity="0.72" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="CopyStatus_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy status" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="How SmartSink routes audio" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="SmartSink asks the existing Windows Bluetooth stack to accept A2DP audio through Windows.Media.Audio.AudioPlaybackConnection. Windows decodes the stream and sends it to the current default output. SmartSink creates no virtual audio device and implements no Bluetooth codec or protocol." TextWrapping="Wrap" LineHeight="22" />
                                <Border Padding="14" CornerRadius="10" Background="{StaticResource SmartSinkSubtlePanelBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" Foreground="{StaticResource SmartSinkCyanBrush}" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Stop is safe" FontWeight="SemiBold" />
                                            <TextBlock Text="Stop disposes only SmartSink's A2DP connection. The phone remains paired, Bluetooth remains enabled, and unrelated Phone Link functionality is untouched." TextWrapping="Wrap" Opacity="0.7" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
